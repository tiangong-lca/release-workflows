{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lca.tiangong.earth/release/publication-execution-receipt.v2.schema.json",
  "title": "Publication Execution Receipt v2 (mixed-state)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "approvalSha256",
    "executablePlanSha256",
    "payloadManifestSha256",
    "targetId",
    "stateMapping",
    "completedAt",
    "datasetCount",
    "resultProcessDatasetCount",
    "completedKeys",
    "eventCount",
    "eventLogHash",
    "independentReadbackVerified"
  ],
  "properties": {
    "schemaVersion": {
      "const": "tiangong.release.publication-execution-receipt.v2"
    },
    "status": { "const": "published" },
    "approvalSha256": { "$ref": "#/$defs/hash" },
    "executablePlanSha256": { "$ref": "#/$defs/hash" },
    "payloadManifestSha256": { "$ref": "#/$defs/hash" },
    "targetId": { "type": "string", "minLength": 1 },
    "stateMapping": { "$ref": "#/$defs/stateMapping" },
    "completedAt": { "type": "string", "format": "date-time" },
    "datasetCount": { "type": "integer", "minimum": 1 },
    "resultProcessDatasetCount": { "type": "integer", "minimum": 0 },
    "completedKeys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "eventCount": { "type": "integer", "minimum": 1 },
    "eventLogHash": { "$ref": "#/$defs/hash" },
    "independentReadbackVerified": { "const": false }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "stateMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roleTargets", "singleGlobalState"],
      "properties": {
        "roleTargets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result_process",
            "unit_process",
            "lifecycle_model",
            "support"
          ],
          "properties": {
            "result_process": { "const": 120 },
            "unit_process": { "const": 100 },
            "lifecycle_model": { "const": 100 },
            "support": { "const": 100 }
          }
        },
        "singleGlobalState": { "const": false }
      }
    }
  }
}
