{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lca.tiangong.earth/release/publication-executable-plan.v2.schema.json",
  "title": "Publication Executable Plan v2 (mixed-state, per-operation target)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "publicationAuthorized",
    "resultPublicationAuthorized",
    "targetId",
    "contractVersion",
    "publicationDraftPlanSha256",
    "payloadManifestSha256",
    "targetSnapshotSha256",
    "targetFingerprint",
    "stateMapping",
    "operationCount",
    "resultProcessOperationCount",
    "operationFingerprint",
    "operations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "tiangong.release.publication-executable-plan.v2"
    },
    "status": {
      "const": "ready_for_approval"
    },
    "publicationAuthorized": {
      "const": false
    },
    "resultPublicationAuthorized": {
      "const": false
    },
    "targetId": {
      "type": "string",
      "minLength": 1
    },
    "contractVersion": {
      "const": 2
    },
    "publicationDraftPlanSha256": {
      "$ref": "#/$defs/hash"
    },
    "payloadManifestSha256": {
      "$ref": "#/$defs/hash"
    },
    "targetSnapshotSha256": {
      "$ref": "#/$defs/hash"
    },
    "targetFingerprint": {
      "$ref": "#/$defs/hash"
    },
    "stateMapping": {
      "$ref": "#/$defs/stateMapping"
    },
    "operationCount": {
      "type": "integer",
      "minimum": 1
    },
    "resultProcessOperationCount": {
      "type": "integer",
      "minimum": 0
    },
    "operationFingerprint": {
      "$ref": "#/$defs/hash"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/operation"
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stateMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roleTargets", "singleGlobalState"],
      "properties": {
        "roleTargets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result_process",
            "unit_process",
            "lifecycle_model",
            "support"
          ],
          "properties": {
            "result_process": {
              "const": 120
            },
            "unit_process": {
              "const": 100
            },
            "lifecycle_model": {
              "const": 100
            },
            "support": {
              "const": 100
            }
          }
        },
        "singleGlobalState": {
          "const": false
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "role",
        "contentType",
        "table",
        "uuid",
        "version",
        "expectedCanonicalContentHash",
        "targetStateCode",
        "action",
        "remoteWrites",
        "classification",
        "observedStateCode",
        "observedContentHash"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "result_process",
            "unit_process",
            "lifecycle_model",
            "support"
          ]
        },
        "contentType": {
          "enum": ["result-process", "ordinary-dataset"]
        },
        "table": {
          "type": "string",
          "minLength": 1
        },
        "uuid": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]{2}\\.[0-9]{2}\\.[0-9]{3}$"
        },
        "expectedCanonicalContentHash": {
          "$ref": "#/$defs/hash"
        },
        "targetStateCode": {
          "enum": [100, 120]
        },
        "action": {
          "enum": [
            "create_then_publish",
            "publish_existing",
            "already_published_noop",
            "reconcile_via_manager_command"
          ]
        },
        "remoteWrites": {
          "type": "boolean"
        },
        "classification": {
          "enum": [
            "absent",
            "matching_unpublished",
            "matching_published",
            "matching_not_publishable",
            "content_conflict"
          ]
        },
        "observedStateCode": {
          "type": ["integer", "null"]
        },
        "observedContentHash": {
          "oneOf": [
            {
              "$ref": "#/$defs/hash"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
