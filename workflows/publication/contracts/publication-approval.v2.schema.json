{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lca.tiangong.earth/release/publication-approval.v2.schema.json",
  "title": "Publication Approval v2 (mixed-state, manager-attested)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "publicationAuthorized",
    "resultPublicationAuthorized",
    "contractVersion",
    "targetId",
    "executablePlanSha256",
    "publicationDraftPlanSha256",
    "payloadManifestSha256",
    "targetSnapshotSha256",
    "targetFingerprint",
    "stateMapping",
    "managerAttestation",
    "approvedBy",
    "approvedAt",
    "expiresAt",
    "reason"
  ],
  "properties": {
    "schemaVersion": { "const": "tiangong.release.publication-approval.v2" },
    "status": { "const": "approved" },
    "publicationAuthorized": { "const": true },
    "resultPublicationAuthorized": { "type": "boolean" },
    "contractVersion": { "const": 2 },
    "targetId": { "type": "string", "minLength": 1 },
    "executablePlanSha256": { "$ref": "#/$defs/hash" },
    "publicationDraftPlanSha256": { "$ref": "#/$defs/hash" },
    "payloadManifestSha256": { "$ref": "#/$defs/hash" },
    "targetSnapshotSha256": { "$ref": "#/$defs/hash" },
    "targetFingerprint": { "$ref": "#/$defs/hash" },
    "stateMapping": { "$ref": "#/$defs/stateMapping" },
    "managerAttestation": {
      "oneOf": [{ "$ref": "#/$defs/attestation" }, { "type": "null" }]
    },
    "approvedBy": { "type": "string", "minLength": 1, "maxLength": 256 },
    "approvedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "reason": { "type": ["string", "null"], "maxLength": 1000 }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "stateMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roleTargets", "singleGlobalState"],
      "properties": {
        "roleTargets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result_process",
            "unit_process",
            "lifecycle_model",
            "support"
          ],
          "properties": {
            "result_process": { "const": 120 },
            "unit_process": { "const": 100 },
            "lifecycle_model": { "const": 100 },
            "support": { "const": 100 }
          }
        },
        "singleGlobalState": { "const": false }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "status",
        "assertion",
        "lineage",
        "attestedBy",
        "attestedByUserId",
        "attestedAt",
        "executablePlanSha256",
        "resultProcessOperationCount",
        "rowsHash",
        "rows"
      ],
      "properties": {
        "schemaVersion": { "const": "tiangong.release.manager-attestation.v1" },
        "status": { "const": "asserted" },
        "assertion": { "const": "manager_attested_authorization" },
        "lineage": { "const": "not_machine_verified" },
        "attestedBy": { "type": "string", "minLength": 1, "maxLength": 256 },
        "attestedByUserId": { "type": "string", "format": "uuid" },
        "attestedAt": { "type": "string", "format": "date-time" },
        "executablePlanSha256": { "$ref": "#/$defs/hash" },
        "resultProcessOperationCount": { "type": "integer", "minimum": 1 },
        "rowsHash": { "$ref": "#/$defs/hash" },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/attestationRow" }
        }
      }
    },
    "attestationRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertedRole",
        "uuid",
        "version",
        "canonicalContentHash",
        "targetStateCode",
        "candidateSetHash",
        "sourceManifestHash",
        "planSha256"
      ],
      "properties": {
        "assertedRole": { "const": "result_process" },
        "uuid": { "type": "string", "format": "uuid" },
        "version": {
          "type": "string",
          "pattern": "^[0-9]{2}\\.[0-9]{2}\\.[0-9]{3}$"
        },
        "canonicalContentHash": { "$ref": "#/$defs/hash" },
        "targetStateCode": { "const": 120 },
        "candidateSetHash": {
          "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }]
        },
        "sourceManifestHash": {
          "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }]
        },
        "planSha256": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
