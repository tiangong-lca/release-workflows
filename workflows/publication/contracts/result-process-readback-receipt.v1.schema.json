{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lca.tiangong.earth/release/result-process-readback-receipt.v1.schema.json",
  "title": "Result Process Readback Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "independentlyQueried",
    "executionReceiptSha256",
    "preparationSha256",
    "approvalSha256",
    "executablePlanSha256",
    "payloadManifestSha256",
    "actorUserId",
    "verifiedAt",
    "operationCount",
    "verifiedSetHash",
    "rows"
  ],
  "properties": {
    "schemaVersion": {
      "const": "tiangong.release.result-process-readback-receipt.v1"
    },
    "status": {
      "const": "verified"
    },
    "independentlyQueried": {
      "const": true
    },
    "executionReceiptSha256": {
      "$ref": "#/$defs/hash"
    },
    "preparationSha256": {
      "$ref": "#/$defs/hash"
    },
    "approvalSha256": {
      "$ref": "#/$defs/hash"
    },
    "executablePlanSha256": {
      "$ref": "#/$defs/hash"
    },
    "payloadManifestSha256": {
      "$ref": "#/$defs/hash"
    },
    "actorUserId": {
      "type": "string",
      "format": "uuid"
    },
    "verifiedAt": {
      "type": "string",
      "format": "date-time"
    },
    "operationCount": {
      "type": "integer",
      "minimum": 1
    },
    "verifiedSetHash": {
      "$ref": "#/$defs/hash"
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/row"
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "role",
        "table",
        "uuid",
        "version",
        "expectedCanonicalContentHash",
        "observedCanonicalContentHash",
        "expectedByteHash",
        "observedByteHash",
        "byteHashDomain",
        "expectedStateCode",
        "observedStateCode",
        "receiptId",
        "publishedAt",
        "verified",
        "serverVerified"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "const": "result_process"
        },
        "table": {
          "type": "string",
          "minLength": 1
        },
        "uuid": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]{2}\\.[0-9]{2}\\.[0-9]{3}$"
        },
        "expectedCanonicalContentHash": {
          "$ref": "#/$defs/hash"
        },
        "observedCanonicalContentHash": {
          "$ref": "#/$defs/hash"
        },
        "expectedByteHash": {
          "$ref": "#/$defs/hash"
        },
        "observedByteHash": {
          "$ref": "#/$defs/hash"
        },
        "byteHashDomain": {
          "const": "result-process-content.v1"
        },
        "expectedStateCode": {
          "const": 120
        },
        "observedStateCode": {
          "const": 120
        },
        "receiptId": {
          "type": "string",
          "format": "uuid"
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "verified": {
          "const": true
        },
        "serverVerified": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rowMatchesReceipt",
            "receiptMatchesRequest",
            "liveManager"
          ],
          "properties": {
            "rowMatchesReceipt": {
              "const": true
            },
            "receiptMatchesRequest": {
              "const": true
            },
            "liveManager": {
              "const": true
            }
          }
        }
      }
    }
  }
}
