{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lca.tiangong.earth/release/result-process-execution-receipt.v1.schema.json",
  "title": "Result Process Execution Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "approvalSha256",
    "executablePlanSha256",
    "payloadManifestSha256",
    "preparationSha256",
    "operationSetHash",
    "actorUserId",
    "completedAt",
    "operationCount",
    "completedKeys",
    "eventCount",
    "eventLogHash",
    "independentReadbackVerified"
  ],
  "properties": {
    "schemaVersion": {
      "const": "tiangong.release.result-process-execution-receipt.v1"
    },
    "status": { "const": "published" },
    "approvalSha256": { "$ref": "#/$defs/hash" },
    "executablePlanSha256": { "$ref": "#/$defs/hash" },
    "payloadManifestSha256": { "$ref": "#/$defs/hash" },
    "preparationSha256": { "$ref": "#/$defs/hash" },
    "operationSetHash": { "$ref": "#/$defs/hash" },
    "actorUserId": { "type": "string", "format": "uuid" },
    "completedAt": { "type": "string", "format": "date-time" },
    "operationCount": { "type": "integer", "minimum": 1 },
    "completedKeys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "eventCount": { "type": "integer", "minimum": 1 },
    "eventLogHash": { "$ref": "#/$defs/hash" },
    "independentReadbackVerified": { "const": false }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
