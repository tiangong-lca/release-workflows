{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lca.tiangong.earth/release/publication-execution-intent.v2.schema.json",
  "title": "Publication Execution Intent v2 (mixed-state)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "approvalSha256",
    "executablePlanSha256",
    "payloadManifestSha256",
    "targetId",
    "stateMapping",
    "managerAttestationRowsHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "tiangong.release.publication-execution-intent.v2"
    },
    "approvalSha256": { "$ref": "#/$defs/hash" },
    "executablePlanSha256": { "$ref": "#/$defs/hash" },
    "payloadManifestSha256": { "$ref": "#/$defs/hash" },
    "targetId": { "type": "string", "minLength": 1 },
    "stateMapping": { "$ref": "#/$defs/stateMapping" },
    "managerAttestationRowsHash": {
      "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }]
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "stateMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roleTargets", "singleGlobalState"],
      "properties": {
        "roleTargets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result_process",
            "unit_process",
            "lifecycle_model",
            "support"
          ],
          "properties": {
            "result_process": { "const": 120 },
            "unit_process": { "const": 100 },
            "lifecycle_model": { "const": 100 },
            "support": { "const": 100 }
          }
        },
        "singleGlobalState": { "const": false }
      }
    }
  }
}
