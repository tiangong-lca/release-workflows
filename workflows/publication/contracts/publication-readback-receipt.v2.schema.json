{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lca.tiangong.earth/release/publication-readback-receipt.v2.schema.json",
  "title": "Publication Readback Receipt v2 (mixed-state)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "independentlyQueried",
    "executionReceiptSha256",
    "executablePlanSha256",
    "approvalSha256",
    "payloadManifestSha256",
    "targetId",
    "stateMapping",
    "verifiedAt",
    "datasetCount",
    "resultProcessDatasetCount",
    "verifiedSetHash",
    "rows"
  ],
  "properties": {
    "schemaVersion": {
      "const": "tiangong.release.publication-readback-receipt.v2"
    },
    "status": {
      "const": "verified"
    },
    "independentlyQueried": {
      "const": true
    },
    "executionReceiptSha256": {
      "$ref": "#/$defs/hash"
    },
    "executablePlanSha256": {
      "$ref": "#/$defs/hash"
    },
    "approvalSha256": {
      "$ref": "#/$defs/hash"
    },
    "payloadManifestSha256": {
      "$ref": "#/$defs/hash"
    },
    "targetId": {
      "type": "string",
      "minLength": 1
    },
    "stateMapping": {
      "$ref": "#/$defs/stateMapping"
    },
    "verifiedAt": {
      "type": "string",
      "format": "date-time"
    },
    "datasetCount": {
      "type": "integer",
      "minimum": 1
    },
    "resultProcessDatasetCount": {
      "type": "integer",
      "minimum": 0
    },
    "verifiedSetHash": {
      "$ref": "#/$defs/hash"
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/row"
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stateMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roleTargets", "singleGlobalState"],
      "properties": {
        "roleTargets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result_process",
            "unit_process",
            "lifecycle_model",
            "support"
          ],
          "properties": {
            "result_process": {
              "const": 120
            },
            "unit_process": {
              "const": 100
            },
            "lifecycle_model": {
              "const": 100
            },
            "support": {
              "const": 100
            }
          }
        },
        "singleGlobalState": {
          "const": false
        }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "role",
        "table",
        "uuid",
        "version",
        "expectedCanonicalContentHash",
        "observedCanonicalContentHash",
        "expectedByteHash",
        "observedByteHash",
        "byteHashDomain",
        "expectedStateCode",
        "observedStateCode",
        "receiptId",
        "publishedAt",
        "verified",
        "serverVerified"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "result_process",
            "unit_process",
            "lifecycle_model",
            "support"
          ]
        },
        "table": {
          "type": "string",
          "minLength": 1
        },
        "uuid": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]{2}\\.[0-9]{2}\\.[0-9]{3}$"
        },
        "expectedCanonicalContentHash": {
          "$ref": "#/$defs/hash"
        },
        "observedCanonicalContentHash": {
          "$ref": "#/$defs/hash"
        },
        "expectedStateCode": {
          "enum": [100, 120]
        },
        "observedStateCode": {
          "enum": [100, 120]
        },
        "verified": {
          "const": true
        },
        "expectedByteHash": {
          "oneOf": [
            {
              "$ref": "#/$defs/hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "observedByteHash": {
          "oneOf": [
            {
              "$ref": "#/$defs/hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "byteHashDomain": {
          "oneOf": [
            {
              "const": "result-process-content.v1"
            },
            {
              "type": "null"
            }
          ]
        },
        "receiptId": {
          "oneOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "publishedAt": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "serverVerified": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rowMatchesReceipt",
                "receiptMatchesRequest",
                "liveManager"
              ],
              "properties": {
                "rowMatchesReceipt": {
                  "const": true
                },
                "receiptMatchesRequest": {
                  "const": true
                },
                "liveManager": {
                  "const": true
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
