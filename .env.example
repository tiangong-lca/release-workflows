# Password-equivalent secret: inject locally or through a protected environment.
TIANGONG_LCA_API_BASE_URL=
TIANGONG_LCA_API_KEY=
TIANGONG_LCA_SUPABASE_PUBLISHABLE_KEY=
TIANGONG_LCA_ACCESS_TOKEN=

# Local Release data plane. These may be copied from the workspace root ignored
# .env with `environment sync --confirm-sync`. Never commit real values.
# Used by explicit result register for immutable identity RPCs, and existing data-plane adapters.
# Never pass the connection string on a command line.
CONN=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
RELEASE_FLOW_CACHE_REMOTE_HOST=
S3_REGION=
S3_BUCKET=

# Optional exact override. Defaults to
# ${TIANGONG_LCA_API_BASE_URL}/functions/v1/app_data_product_commands.
TIANGONG_LCA_DATA_PRODUCT_COMMAND_URL=

# Optional executable overrides for local integration and pinned tool builds.
TIANGONG_LCA_CLI_EXECUTABLE=tiangong-lca
TIANGONG_TIDAS_EXECUTABLE=tidas

# Explicit private Worker readiness probe endpoint and HMAC secret; never actor credentials.
RESULT_QUERY_ENDPOINT=
RESULT_QUERY_SERVICE_SECRET=
